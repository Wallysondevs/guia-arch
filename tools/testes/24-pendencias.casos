### pend-sinais-jobs
sleep 100 &
kill -9 %1; sleep 0.2; jobs
sleep 100 &
kill -HUP %1; sleep 0.2; jobs
kill firefox; echo $?
kill 99999; echo $?
### pend-sinais-jobs2
sleep 100 &
kill -USR1 %1; sleep 0.2; jobs
sleep 100 &
kill -PIPE %1; sleep 0.2; jobs
sleep 100 &
kill -ALRM %1; sleep 0.2; jobs
sleep 100 &
kill -USR2 %1; sleep 0.2; jobs
sleep 100 &
kill -TERM %1; sleep 0.2; jobs
(exit 2) &
sleep 0.2; jobs
### pend-sinais-script [script]
sleep 100 &
kill -INT $!; wait $!; echo "int $?"
sleep 100 &
kill -9 $!; wait $! 2> /tmp/e; echo "kill $?"; sed 's/: *[0-9]* Morto/: N Morto/' /tmp/e
### pend-kill-l
kill -l
kill -l 9 15 HUP
### pend-jobs-aviso
sleep 100 &
kill %1
echo oi
echo dois
sleep 1 &
wait
echo fim
sleep 1 &
sleep 2
echo depois
### pend-trap-term-bg
printf '#!/bin/bash\ntrap "echo pegou TERM" TERM\nfor i in 1 2 3; do sleep 1; done\necho fim do script\n' > s.sh; chmod +x s.sh
./s.sh &
sleep 0.5; kill %1; sleep 4
jobs
bash s.sh &
sleep 0.5; kill $!; sleep 4
### pend-kill-stop
sleep 605 &
kill -STOP %1; sleep 0.2; jobs
ps -o pid=,stat=,cmd= -p $! | sed 's/^ *[0-9]* //'
kill -CONT %1; sleep 0.2; jobs
ps -o stat=,cmd= -p $!
kill %1; sleep 0.2; jobs
### pend-pkill-killall
sleep 300 &
sleep 0.2; pkill -e sleep | sed 's/[0-9][0-9]*/N/'
sleep 301 &
sleep 0.2; killall -v sleep 2>&1 | sed 's/[0-9][0-9]*)/N)/'
killall -v nada; echo $?
pkill -e nada; echo $?
sleep 302 &
sleep 0.2; killall -s KILL -v sleep 2>&1 | sed 's/[0-9][0-9]*)/N)/'
pkill -9 -e nada; echo $?
killall -q nada; echo $?

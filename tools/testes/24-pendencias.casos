### pend-gzip
cd Documentos
## (o tamanho dos compactados é uma estimativa no simulador: os casos cortam os números)
gzip acesso.log; ls -l acesso.log* | cut -d' ' -f1-4,6-
file acesso.log.gz
gzip -l acesso.log.gz | tr -s ' ' | cut -d' ' -f3,5
gunzip acesso.log.gz; ls -l acesso.log*
gzip -k acesso.log; ls acesso.log*
gzip acesso.log; echo $?
gzip -f acesso.log; echo $?
zcat acesso.log.gz | head -2
gzip -d acesso.log.gz; ls acesso.log*
gzip -c notas.txt > n.gz; ls n.gz notas.txt
gzip -v alunos.csv 2>&1 | sed 's/ *[0-9,]*%/ N%/'
gzip nada; echo $?
gzip projetos; echo $?
gzip -dc alunos.csv.gz | head -1
gunzip -k alunos.csv.gz; echo $?
gunzip notas.txt; echo $?
gzip -t alunos.csv.gz; echo $?
### pend-xz-zstd
cd Documentos
xz acesso.log; ls -l acesso.log* | cut -d' ' -f1-4,6-
file acesso.log.xz
unxz acesso.log.xz; ls acesso.log*
xz -k notas.txt; ls notas*
xzcat notas.txt.xz
zstd acesso.log 2>&1 | sed -E 's/[0-9.]+%/N%/; s/=> +[0-9]+ B/=> N B/'
ls acesso.log*
file acesso.log.zst
zstd -d -f acesso.log.zst; echo $?
zstd --rm -f acesso.log 2>&1 | sed -E 's/[0-9.]+%/N%/; s/=> +[0-9]+ B/=> N B/'; ls acesso.log*
zstdcat acesso.log.zst | head -1
unzstd acesso.log.zst; ls acesso.log*
zstd -q alunos.csv; ls alunos*
zstd nada; echo $?
xz nada; echo $?
### pend-tar1
mkdir -p site/css; echo 'body {}' > site/css/style.css; echo '<h1>Oi</h1>' > site/index.html; echo x > site/rascunho.tmp
touch -d '2026-10-16 15:05' site/css/style.css site/index.html site/rascunho.tmp site/css site
tar -czvf site.tar.gz site | sort
tar -tzf site.tar.gz | sort
tar -tvf site.tar.gz | sort -k6
file site.tar.gz
tar -czf s2.tar.gz --exclude="*.tmp" site; tar -tf s2.tar.gz | sort
tar -cf site.tar site; ls -l site.tar | cut -d' ' -f5; file site.tar
tar -cJf site.tar.xz site; file site.tar.xz; tar -tf site.tar.xz | sort
tar --zstd -cf site.tar.zst site; file site.tar.zst
tar -caf auto.tar.zst site; file auto.tar.zst
tar -cjf site.tar.bz2 site; file site.tar.bz2
mkdir r; tar -xvf site.tar.gz -C r | sort; ls r r/site
mkdir so; cd so; tar -xf ../site.tar.gz site/index.html; ls site; cd ..
tar -xOf site.tar.gz site/index.html
tar -czf hostname.tar.gz /etc/hostname; tar -tf hostname.tar.gz
tar -czf backup.tar.gz; echo $?
tar -xf nada.tar; echo $?
tar -tf frutas.txt; echo $?
tar -xzf site.tar.zst; echo $?
tar -tf site.tar.gz nada; echo $?
tar cf velho.tar site/index.html; tar tf velho.tar

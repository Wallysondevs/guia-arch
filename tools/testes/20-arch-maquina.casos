## A máquina Arch: arquivos, usuários, versões (conferidos na VM)
### arch-ls-home
ls -la
ls -l Documentos Downloads Imagens
ls -la aur/yay-bin
stat -c '%a %U %G %s' . .bashrc frutas.txt Documentos
### arch-etc
cat /etc/os-release
cat /etc/hostname /etc/locale.conf /etc/vconsole.conf
cat /etc/fstab
grep -v '^#' /etc/pacman.conf | grep -v '^$'
cat /etc/pacman.d/mirrorlist | grep -v '^#' | grep -v '^$'
grep -E '^GRUB_(DEFAULT|TIMEOUT|CMDLINE_LINUX_DEFAULT|TOP_LEVEL)' /etc/default/grub
cat /etc/shells
grep ana /etc/passwd /etc/group
ls -l /etc/localtime /etc/os-release
### arch-versoes
uname -r
uname -a
uname -m
bash --version | head -1
echo $BASH_VERSION
echo ${BASH_VERSINFO[@]}
id
groups
whoami
hostname
nproc
### arch-raiz
ls /
ls -ld / /root /home /tmp /boot
ls /boot
ls -l /usr/bin/sh /usr/bin/awk
type -a sh awk
### arch-env
echo $PATH
echo $HOME $USER $SHELL $LANG
echo $HISTSIZE "$HISTCONTROL"
alias
### arch-comandos-ausentes
apt install vlc
dpkg -l
snap list
neofetch
echo $?
### arch-df-lsblk
df -h /
df -hT /boot
lsblk
lsblk -f
findmnt /
findmnt /boot
free -h | head -1
### arch-ctl
hostnamectl | grep -E 'Static|Operating|Kernel|Architecture|Chassis'
localectl
timedatectl | grep -E 'Time zone|synchronized|NTP|RTC in'
### arch-ip
ip -br link
ip r
ip link
